{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The editor window: file dialogs, window title, close confirmation and opening links externally.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url"
  ]
}
